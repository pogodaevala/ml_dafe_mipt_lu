    "spectral_init = spectral_vectors[:, 1:3]\n",
    "spectral_init = 10 * (spectral_init - spectral_init.min(axis=0)) / (spectral_init.max(axis=0) - spectral_init.min(axis=0))\n",
    "print(\"компонент связности графа:\", n_components_graph)\n",
