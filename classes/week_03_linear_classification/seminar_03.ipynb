      "веса до:    [-0.052 -0.352]  после: [ 0.022 -0.152]\n"
     ]
    }
   ],
   "source": [
    "rng_far = np.random.default_rng(SEED)\n",
    "far_wines = rng_far.normal([-1.5, -6.0], 0.4, (15, 2))\n",
    "X_with_far = np.vstack([X_train, far_wines])\n",
